# Copy to .env.local for local development. On Vercel, set these under
# Project Settings -> Environment Variables (Production and Preview). Never commit real values.

# Resend API key, used by /api/audit to email new audit requests.
RESEND_API_KEY=
# Where audit requests are sent.
LEAD_TO_EMAIL=
# Verified sender in Resend, e.g. "ShortList <audit@yourdomain.in>".
LEAD_FROM_EMAIL=
# Public site URL for metadata, sitemap and Open Graph (e.g. https://shortlist.in).
# On Vercel this falls back to the production URL automatically.
NEXT_PUBLIC_SITE_URL=
